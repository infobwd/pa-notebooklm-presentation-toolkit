{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infobwd.github.io/pa-notebooklm-presentation-toolkit/web/schema/project.schema.json",
  "title": "PA NotebookLM Toolkit Project",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "const": "pa-toolkit/project/3.1"
    },
    "version": {
      "const": 3
    },
    "duration": {
      "type": "string",
      "enum": [
        "5",
        "7"
      ]
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "actualNumerator": {
            "type": "string"
          },
          "actualDenominator": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          },
          "sourcePage": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "population": {
            "type": "string"
          },
          "cohortId": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "actualMode": {
            "type": "string",
            "enum": [
              "pending",
              "fraction",
              "percent",
              "score",
              "text"
            ]
          }
        },
        "required": [
          "title",
          "target",
          "actual",
          "actualMode",
          "evidence",
          "actualNumerator",
          "actualDenominator",
          "sourceFile",
          "sourcePage",
          "period",
          "population",
          "cohortId",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "evidenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectedFileNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentStep": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "visualNamingPlan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "number"
              },
              "filename": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "evidenceType": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "order",
              "filename",
              "label",
              "evidenceType",
              "aliases"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "title",
        "slots"
      ],
      "additionalProperties": false
    },
    "visualAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "canonicalName": {
            "type": "string"
          },
          "slotId": {
            "type": "string"
          },
          "evidenceType": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "originalName",
          "canonicalName",
          "slotId",
          "evidenceType",
          "mimeType",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "evidenceReviewNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          },
          "sourcePage": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "sectionHint": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "unclassified",
              "fact",
              "target",
              "actual",
              "context",
              "pending"
            ]
          },
          "linkedIndicatorId": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "candidate",
              "checked",
              "rejected"
            ]
          },
          "note": {
            "type": "string"
          },
          "extractionMode": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sourceFile",
          "sourcePage",
          "excerpt",
          "query",
          "sectionHint",
          "classification",
          "linkedIndicatorId",
          "reviewStatus",
          "note",
          "extractionMode"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}